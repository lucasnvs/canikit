{
  "identifier": "default",
  "description": "Default capability for CaniKit",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:scope-home-recursive",
    "fs:scope-document-recursive",
    "fs:scope-applocaldata-recursive",
    "shell:allow-execute",
    "shell:allow-spawn"
  ]
}
